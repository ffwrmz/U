@startuml SantaTeresita_ModeloDatos

hide circle
skinparam linetype ortho
skinparam roundcorner 10
skinparam shadowing false
skinparam class {
    BackgroundColor White
    BorderColor #444444
    ArrowColor #444444
}

entity "usuarios" as usuarios {
    * id_usuario : SERIAL <<PK>>
    --
    nombre : VARCHAR(100)
    email : VARCHAR(100) <<UNIQUE>>
    password_hash : VARCHAR(255)
    telefono : VARCHAR(20)
    rol : RolUsuario
    creado_en : TIMESTAMP
}

entity "direcciones" as direcciones {
    * id_direccion : SERIAL <<PK>>
    --
    calle : VARCHAR(150)
    numero : VARCHAR(10)
    villa_poblacion : VARCHAR(100)
    comuna : VARCHAR(50)
    ciudad : VARCHAR(50)
    referencia : TEXT
    latitud : NUMERIC(10,8)
    longitud : NUMERIC(11,8)
}

entity "clientes" as clientes {
    * id_cliente : SERIAL <<PK>>
    --
    # id_usuario : INTEGER <<FK>>
    # id_direccion : INTEGER <<FK>>
    rut : VARCHAR(12) <<UNIQUE>>
    nombre_completo : VARCHAR(150)
    telefono : VARCHAR(20)
    deuda_total_acumulada : NUMERIC(12,2)
}

entity "furgones" as furgones {
    * id_furgon : SERIAL <<PK>>
    --
    patente : VARCHAR(10) <<UNIQUE>>
    modelo : VARCHAR(50)
    estado : EstadoFurgon
}

entity "rutas" as rutas {
    * id_ruta : SERIAL <<PK>>
    --
    # id_casero : INTEGER <<FK>>
    # id_furgon : INTEGER <<FK>>
    fecha : DATE
    estado : EstadoRuta
}

entity "visitas_ruta" as visitas_ruta {
    * id_visita : SERIAL <<PK>>
    --
    # id_ruta : INTEGER <<FK>>
    # id_cliente : INTEGER <<FK>>
    orden_visita : INTEGER
    estado_visita : EstadoVisita
}

entity "productos" as productos {
    * id_producto : SERIAL <<PK>>
    --
    nombre : VARCHAR(100)
    descripcion : TEXT
    categoria : VARCHAR(50)
    precio_lista : NUMERIC(10,2)
    imagen_url : TEXT
    stock_bodega_central : INTEGER
}

entity "inventario_furgon" as inventario_furgon {
    * id_inventario : SERIAL <<PK>>
    --
    # id_furgon : INTEGER <<FK>>
    # id_producto : INTEGER <<FK>>
    cantidad_disponible : INTEGER
}

entity "ventas" as ventas {
    * id_venta : SERIAL <<PK>>
    --
    # id_cliente : INTEGER <<FK>>
    # id_casero : INTEGER <<FK>>
    fecha_venta : TIMESTAMP
    tipo_pago : TipoPago
    monto_total : NUMERIC(10,2)
    pie_inicial : NUMERIC(10,2)
    saldo_pendiente : NUMERIC(10,2)
    estado_pago : EstadoPago
}

entity "detalle_ventas" as detalle_ventas {
    * id_detalle : SERIAL <<PK>>
    --
    # id_venta : INTEGER <<FK>>
    # id_producto : INTEGER <<FK>>
    cantidad : INTEGER
    precio_unitario : NUMERIC(10,2)
}

entity "abonos" as abonos {
    * id_abono : SERIAL <<PK>>
    --
    # id_cliente : INTEGER <<FK>>
    # id_casero : INTEGER <<FK>>
    monto_total_pagado : NUMERIC(10,2)
    metodo_pago : MetodoPago
    fecha_pago : TIMESTAMP
}

entity "abono_aplicacion" as abono_aplicacion {
    * id_aplicacion : SERIAL <<PK>>
    --
    # id_abono : INTEGER <<FK>>
    # id_venta : INTEGER <<FK>>
    monto_aplicado : NUMERIC(10,2)
}

entity "ubicaciones_gps" as ubicaciones_gps {
    * id_ubicacion : SERIAL <<PK>>
    --
    # id_casero : INTEGER <<FK>>
    latitud : NUMERIC(10,8)
    longitud : NUMERIC(11,8)
    fecha_hora : TIMESTAMP
}

enum RolUsuario {
    GERENTE
    CASERO
    CLIENTE
}

enum EstadoFurgon {
    DISPONIBLE
    EN_RUTA
    MANTENCION
}

enum EstadoRuta {
    PENDIENTE
    EN_PROCESO
    FINALIZADA
}

enum EstadoVisita {
    PENDIENTE
    VISITADO
    NO_ESTA
}

enum TipoPago {
    CONTADO
    CREDITO
}

enum EstadoPago {
    PENDIENTE
    PARCIAL
    PAGADO
}

enum MetodoPago {
    EFECTIVO
    TRANSFERENCIA
}

usuarios ||--o| clientes : "vincula cuenta"
direcciones ||--o{ clientes : "es domicilio de"
usuarios ||--o{ rutas : "es casero de"
furgones ||--o{ rutas : "asignado en"
furgones ||--o{ inventario_furgon : "contiene"
productos ||--o{ inventario_furgon : "se distribuye en"
rutas ||--o{ visitas_ruta : "contiene"
clientes ||--o{ visitas_ruta : "programado en"
clientes ||--o{ ventas : "realiza compra"
usuarios ||--o{ ventas : "registra venta"
ventas ||--o{ detalle_ventas : "incluye"
productos ||--o{ detalle_ventas : "es vendido en"
clientes ||--o{ abonos : "efectua abono"
usuarios ||--o{ abonos : "recibe pago"
abonos ||--o{ abono_aplicacion : "se distribuye en"
ventas ||--o{ abono_aplicacion : "recibe aplicacion"
usuarios ||--o{ ubicaciones_gps : "genera rastreo"

@enduml
